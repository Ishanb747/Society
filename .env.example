# Postgres connection string. On Neon use the POOLED one (host contains "-pooler"). Used by the running app.
DATABASE_URL=

# Neon DIRECT (non-pooled) connection string. Used for migrations and the seed. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# 32+ random characters that sign the login cookie, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Optional. Without it, complaint classification falls back to the keyword classifier.
ANTHROPIC_API_KEY=

# Optional. Vercel Blob read/write token for complaint photos. Without it, small photos are stored in the database.
BLOB_READ_WRITE_TOKEN=
